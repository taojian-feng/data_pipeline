# AWS Lambda image: one image, two handlers (see infra/terraform/compute.tf)
FROM public.ecr.aws/lambda/python:3.12
COPY pyproject.toml README.md LICENSE /tmp/build/
COPY src /tmp/build/src
COPY contracts /tmp/build/contracts
COPY seeds /tmp/build/seeds
RUN pip install --no-cache-dir "/tmp/build[aws]" --target "${LAMBDA_TASK_ROOT}" && rm -rf /tmp/build
CMD ["gridlake.aws_lambda.step_handler"]
